{
  "name": "robot-chess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 3D robot chess game for kids, with a coach. Static site, no backend.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
